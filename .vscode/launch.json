{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train tokenizer (tiny shakespeare)",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/llm",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Train tokenizer (enwik8)",
            "type": "go",
