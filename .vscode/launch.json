            "mode": "debug",
            "program": "${workspaceFolder}/cmd/llm",
            "cwd": "${workspaceFolder}",
            "args": ["-data", "data/enwik8", "-vocab", "4096"]
        },
        {
            "name": "Debug tests in current package",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}"
        }
    ]
}
